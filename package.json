  "devDependencies": {
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "1.64.1",
    "@types/node": "26.1.0",
    "allure": "3.33.0",
    "allure-js-commons": "3.14.0",
    "allure-playwright": "3.14.0",
    "dotenv": "^17.4.2"
  }
}
